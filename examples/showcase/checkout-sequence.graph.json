  "groups": [
    {
      "id": "stock-retry",
      "kind": "loop",
      "label": "库存预占重试",
      "loop": {
        "min": 1,
        "max": 3
      },
      "operands": [
        {
          "id": "attempt",
          "guard": "可重试且 attempt ≤ 3",
          "edgeIds": [
            "m4",
            "m5"
          ]
        }
      ]
    },
    {
      "id": "stock-result",
      "kind": "alt",
      "label": "库存预占结果",
      "operands": [
        {
          "id": "held",
          "guard": "库存预占成功",
          "edgeIds": [
            "m6",
            "m7",
            "m8",
            "m9"
          ]
        },
        {
          "id": "empty",
          "guard": "else · 库存不足",
          "edgeIds": [
            "m20"
          ]
        }
      ]
    },
    {
      "id": "payment-result",
      "kind": "alt",
      "label": "支付授权结果",
      "parentId": "stock-result",
      "parentOperandId": "held",
      "operands": [
        {
          "id": "approved",
          "guard": "授权成功",
          "edgeIds": [
            "m10"
          ]
        },
        {
          "id": "declined",
          "guard": "else · 授权失败",
          "edgeIds": [
            "m17",
            "m18",
            "m19"
          ]
        }
      ]
    },
    {
      "id": "parallel-consumers",
      "kind": "par",
      "label": "并行事件处理",
      "parentId": "payment-result",
      "parentOperandId": "approved",
      "operands": [
        {
          "id": "delivery",
          "label": "履约消费者",
          "edgeIds": [
            "m11",
            "m12",
            "m13",
            "m14"
          ]
        },
        {
          "id": "confirmation",
          "label": "通知消费者",
          "edgeIds": [
            "m15",
            "m16"
          ]
        }
      ]
    },
    {
      "id": "valid-webhook",
      "kind": "opt",
      "label": "异步支付回调",
      "operands": [
        {
          "id": "verified",
          "guard": "签名有效",
          "edgeIds": [
            "m24"
          ]
        }
      ]
    },
    {
      "id": "idempotency",
      "kind": "alt",
      "label": "回调幂等处理",
      "parentId": "valid-webhook",
      "parentOperandId": "verified",
      "operands": [
        {
          "id": "new",
          "guard": "首次处理 eventId",
          "edgeIds": [
            "m25",
            "m26",
            "m27"
          ]
        },
        {
          "id": "duplicate",
          "guard": "else · 重复事件",
          "edgeIds": [
            "m28"
          ]
        }
      ]
    }
  ],
