          },
          "size": {
            "width": 300,
            "height": 150
          },
          "facts": [
            "Almacena el registro en el búfer y recibe batchIsFull, newBatchCreated y future del acumulador."
          ],
          "source": {
            "file": "clients/src/main/java/org/apache/kafka/clients/producer/KafkaProducer.java",
