      "meta": {
        "title": "Kafka: ¿cuándo despierta send() a Sender?",
        "scope": "La bifurcación posterior a RecordAccumulator.append(). Se omiten las validaciones y excepciones anteriores. Devolver un Future no significa que el broker haya confirmado el registro.",
        "diagramType": "flowchart",
        "sourceRef": "Apache Kafka · 634a935e7291",
        "locale": "es"
      },
