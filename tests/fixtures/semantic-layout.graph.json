          "evidence": "inference",
          "replyTo": "c2"
        },
        {
          "id": "c4",
          "source": "order",
          "target": "inventory",
          "order": 13,
          "label": "tryReserve()",
          "kind": "sync",
          "evidence": "inference"
        },
        {
          "id": "r4",
          "source": "inventory",
          "target": "order",
          "order": 15,
          "label": "ACQUIRED / BUSY",
          "kind": "return",
          "evidence": "inference",
          "replyTo": "c4"
        },
        {
          "id": "c5",
          "source": "order",
          "target": "risk",
          "order": 27,
