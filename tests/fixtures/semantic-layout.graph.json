      "groups": [
        {
          "id": "retry",
          "kind": "loop",
          "label": "尝试预留库存",
          "loop": {
            "min": 1,
            "max": 3
          },
          "operands": [
            {
              "id": "attempt",
              "guard": "attempt < 3 && !reserved",
              "edgeIds": [
                "c4",
                "r4"
              ]
            }
          ]
        },
        {
          "id": "outcome",
          "kind": "alt",
          "label": "处理本次结果",
          "parentId": "retry",
          "parentOperandId": "attempt",
          "operands": [
            {
              "id": "acquired",
              "guard": "reservation = ACQUIRED",
              "edgeIds": [],
              "body": "reserved ← true；下一次检查退出循环"
            },
            {
              "id": "busy",
              "guard": "else",
              "edgeIds": [],
              "body": "attempt ← attempt + 1；最多尝试 3 次"
            }
          ]
        },
        {
          "id": "optional",
          "kind": "opt",
          "label": "预留成功后执行",
          "operands": [
            {
              "id": "reserved",
              "guard": "reserved = true",
              "edgeIds": []
            }
          ]
        },
        {
          "id": "parallel",
          "kind": "par",
          "label": "分支并行，末端汇合",
          "parentId": "optional",
          "parentOperandId": "reserved",
          "operands": [
            {
              "id": "risk",
              "label": "风险检查",
              "edgeIds": [
                "c5",
                "r5"
              ]
            },
            {
              "id": "audit",
              "label": "审计记录",
              "edgeIds": [
                "c6",
                "r6"
              ]
            }
          ]
        }
      ],
      "layout": {
        "participantOrder": [
          "client",
          "order",
          "inventory",
          "risk",
          "audit"
        ]
      }
