      "meta": {
        "title": "Create-order call sequence",
        "diagramType": "sequence",
        "sourceRef": "intake-shop local working tree",
        "locale": "en",
        "scope": "Default flow detail: handle(order) through createOrder, reserve, charge, authorize, saveOrder, and conditional release, including call returns, empty-order validation, invalid-total authorization, and compensation for charge or persistence errors. Built-in Map operations are described within participants. The sequence starts at the implemented controller; no HTTP caller or route wiring is assumed.",
        "notes": [
          "saveOrder runs only after charge resolves; catch releases inventory for errors from charge or saveOrder.",
          "reserve runs before try; a reservation error bypasses compensation.",
          "release errors are not caught here and can replace the original error.",
          "ProviderClient is local code; an external payment integration is not verified.",
          "Source tracing verifies the implemented path, not runtime wiring or execution."
        ]
      },
